# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment and secrets (never commit real values)
.env
.env.*
!.env.example

# EAS / credentials (keystores live on Expo servers; do not commit local exports)
credentials.json
google-services.json
GoogleService-Info.plist
service-account*.json

# typescript
*.tsbuildinfo

# test coverage (generated)
coverage/

# generated native folders
/ios
/android

# IDE / local agent tooling
.idea/
.vscode/
.claude/
.cursor/

# OS / misc
Thumbs.db
*.log

# DevLoop run outputs (keep specs/docs, ignore generated artifacts)
devloop/runs/*
!devloop/runs/.gitkeep
# ...but keep the two benchmark batches as raw-run EVIDENCE for the report
!devloop/runs/baseline-20260615-032556/
!devloop/runs/baseline-20260615-032556/**
!devloop/runs/baseline-20260615-032556.json
!devloop/runs/baseline-20260615-090927/
!devloop/runs/baseline-20260615-090927/**
!devloop/runs/baseline-20260615-090927.json
devloop/artifacts/*
!devloop/artifacts/.gitkeep
# Keep the captured MCP traces for the same two batches as failure evidence
!devloop/artifacts/traces/
devloop/artifacts/traces/*
!devloop/artifacts/traces/baseline-20260615-032556/
!devloop/artifacts/traces/baseline-20260615-032556/**
!devloop/artifacts/traces/baseline-20260615-090927/
!devloop/artifacts/traces/baseline-20260615-090927/**
